ientas} toggle_history{Historial} toggle_layers{Capas} toggle_colors{Colores} next_image{Imagen siguiente} previous_image{Imagen anterior} help{Ayuda} effect_ink_sketch{Boceto en tinta…} effect_pencil_sketch{Boceto a lápiz…} effect_fragment{Fragmentación…} effect_radial_blur{Desenfoque radial…} effect_surface_blur{Desenfoque de superficie…} effect_unfocus{Desenfocar…} effect_zoom_blur{Desenfoque de zoom…} effect_bulge{Abultamiento…} effect_dents{Abolladuras…} effect_frosted_glass{Vidrio esmerilado…} effect_polar_inversion{Inversión polar…} effect_tile_reflection{Reflejo en mosaico…} effect_twist{Torsión…} effect_reduce_noise{Reducir ruido…} effect_glow{Resplandor…} effect_red_eye_removal{Eliminación de ojos rojos…} effect_soften_portrait{Suavizar retrato…} effect_clouds{Nubes…} effect_julia_fractal{Fractal de Julia…} effect_mandelbrot_fractal{Fractal de Mandelbrot…} effect_relief{Relieve…} other{}}",
